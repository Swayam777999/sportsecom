                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "const o = pm.response.json();",
                  "pm.environment.set(\"orderId\", o.id);",
                  "pm.test(\"price comes from the server and total matches\", function () { pm.expect(o.total).to.eql(o.items.reduce((s, i) => s + i.unitPrice * i.quantity, 0)); });",
                  "pm.test(\"status is PLACED\", function () { pm.expect(o.status).to.eql(\"PLACED\"); });"
                ]
              }
            }
          ]
