{
  "info": {
    "_postman_id": "85284311-2aa4-4eaa-a7d4-3ba14b63d984",
    "name": "Sports Shop API",
    "description": "Select the 'Sports Shop - Local' environment, fill firebaseApiKey/email/password, run '0. Auth' first, then run the folders in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{idToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Auth (Firebase REST - get your JWT)",
      "item": [
        {
          "name": "Sign up (first time only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={{firebaseApiKey}}",
              "protocol": "https",
              "host": [
                "identitytoolkit",
                "googleapis",
                "com"
              ],
              "path": [
                "v1",
                "accounts:signUp"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{firebaseApiKey}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"returnSecureToken\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Creates the Firebase user and stores idToken (a JWT) in the environment. Run once; afterwards use Sign in."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 (or 400 if user exists)\", function () { pm.expect([200, 400]).to.include(pm.response.code); });",
                  "const j = pm.response.json();",
                  "if (j.idToken) {",
                  "  pm.environment.set(\"idToken\", j.idToken);",
                  "  pm.environment.set(\"refreshToken\", j.refreshToken);",
                  "  pm.test(\"Got a JWT (3 dot-separated parts)\", function () { pm.expect(j.idToken.split(\".\")).to.have.lengthOf(3); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in (get a fresh JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}",
              "protocol": "https",
              "host": [
                "identitytoolkit",
                "googleapis",
                "com"
              ],
              "path": [
                "v1",
                "accounts:signInWithPassword"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{firebaseApiKey}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"returnSecureToken\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Run this whenever idToken expires (~1 hour)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.environment.set(\"idToken\", j.idToken);",
                  "pm.environment.set(\"refreshToken\", j.refreshToken);",
                  "pm.test(\"Got a JWT (3 dot-separated parts)\", function () { pm.expect(j.idToken.split(\".\")).to.have.lengthOf(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "https://securetoken.googleapis.com/v1/token?key={{firebaseApiKey}}",
              "protocol": "https",
              "host": [
                "securetoken",
                "googleapis",
                "com"
              ],
              "path": [
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{firebaseApiKey}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refreshToken}}"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Alternative to Sign in: exchanges the refresh token for a new idToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.environment.set(\"idToken\", j.id_token);",
                  "pm.environment.set(\"refreshToken\", j.refresh_token);"
                ]
              }
            }
          ]
        }
      ],
      "description": "Firebase issues the JWT. Postman calls Firebase's REST API directly because the Kotlin API has no login endpoint (by design)."
    },
