rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images are publicly readable; uploads only via console/Admin.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
